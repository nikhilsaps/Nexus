CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# Console + ESP_LOG to the ESP32-S3 native USB (COM3)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Enable PM support; Settings > Power Save opts into 80-240 MHz DFS (no sleep)
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# BLE via NimBLE (HID over GATT); BLE-only part, bonding persisted in NVS
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_HID_SERVICE=y
CONFIG_BT_NIMBLE_SVC_HID_MAX_INSTANCES=1
# Native USB HID via TinyUSB (lazy: installed only inside USB > Control)
CONFIG_TINYUSB_HID_COUNT=1
# LocalServe Wired: USB-CDC-NCM network adapter (built-in Win11/macOS/Linux driver)
CONFIG_TINYUSB_NET_MODE_NCM=y
# FATFS long filenames for the microSD browser (Storage)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
# HTTP server: real phones/browsers send >512B of request headers (captive
# portal probes + cookies). Bump the request buffers so they aren't rejected
# with "Header too long". URI buffer raised to match.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024
# --- Akashic / LocalServe: RAM + HTTPS-proxy tuning ---
# Smaller code (-Os): frees flash and some RAM
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Trim WiFi buffers (reader app is low-bandwidth/bursty, not a throughput load)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# mbedTLS: free handshake scratch + shrink I/O buffers so the /api/fetch HTTPS
# proxy fits in 512KB-RAM (no PSRAM); cert bundle = no per-site cert pinning
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Smaller printf + quieter logs
CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
