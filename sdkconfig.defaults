CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# Console + ESP_LOG to the ESP32-S3 native USB (COM3)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Enable PM support; Settings > Power Save opts into 80-240 MHz DFS (no sleep)
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# BLE via NimBLE (HID over GATT); BLE-only part, bonding persisted in NVS
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_HID_SERVICE=y
CONFIG_BT_NIMBLE_SVC_HID_MAX_INSTANCES=1
# Native USB HID via TinyUSB (lazy: installed only inside USB > Control)
CONFIG_TINYUSB_HID_COUNT=1
# LocalServe Wired: USB-CDC-NCM network adapter (built-in Win11/macOS/Linux driver)
CONFIG_TINYUSB_NET_MODE_NCM=y
# FATFS long filenames for the microSD browser (Storage)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
